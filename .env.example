# Copy this file to .env  (PowerShell: copy .env.example .env) and fill in your values.
# .env is private: never commit it, never paste it in chat. Help: docs/SETUP_GUIDE.md

# ---------- Secrets ----------
# Claude API key from console.anthropic.com (leave empty -> LLM module runs in mock mode)
ANTHROPIC_API_KEY=
# Telegram bot token from @BotFather (leave empty -> bot features are skipped)
TELEGRAM_BOT_TOKEN=
# Our own internal password that protects the Offers API (make one: python -c "import secrets; print(secrets.token_urlsafe(32))")
OFFERS_API_KEY=change-me

# ---------- Claude models ----------
# Fast + cheap model used to write short offer messages
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Smarter model used by the chat shopping assistant
CLAUDE_MODEL_SMART=claude-sonnet-5-5

# ---------- Telegram ----------
# Your bot's username without the @ (used to build deep links like t.me/<username>?start=<token>)
TELEGRAM_BOT_USERNAME=Sutlejbot

# ---------- General ----------
# Timezone for quiet hours and schedules
TIMEZONE=Asia/Kolkata
# Where the SQLite database file lives
DB_PATH=data/app.db
# Which data to load: sample (tiny fixtures) | synthetic (Phase 1 full data) | external (real dataset)
DATA_SOURCE=synthetic
# Folder name inside data/processed/ to use when DATA_SOURCE=external (e.g. amazon_reviews_2023)
EXTERNAL_SOURCE=
# Address of our Offers API service
OFFERS_API_URL=http://127.0.0.1:8001
# Address of our main recommendation API service
MAIN_API_URL=http://127.0.0.1:8010

# ---------- Guardrail limits ----------
# NOTE: offers/rules.yaml (Offer Control Room, port 8502) overrides these values.
# Biggest discount (%) any offer may give
MAX_DISCOUNT_PCT=40
# Max offer messages one user can receive per day
MAX_OFFERS_PER_DAY=1
# Max offer messages one user can receive per week
MAX_OFFERS_PER_WEEK=3
# No messages after this time (local TIMEZONE)...
QUIET_START=22:00
# ...until this time the next morning
QUIET_END=08:00
# Offers worth more than this (₹) need human approval before sending
APPROVAL_THRESHOLD_INR=1000
# Total discount (₹) the system may hand out per day across all users
DAILY_DISCOUNT_BUDGET_INR=50000
