{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "offers-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "offers.api:app", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "main-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "storefront",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "ui/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
