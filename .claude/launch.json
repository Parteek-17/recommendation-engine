{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "offers-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "offers.api:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "main-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "storefront",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "ui/app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "port": 8501
    },
    {
      "name": "control-room",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "ui/control_room.py",
        "--server.port",
        "8502",
        "--server.headless",
        "true"
      ],
      "port": 8502
    },
    {
      "name": "admin-preview",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "ui/control_room.py",
        "--server.port",
        "8503",
        "--server.headless",
        "true"
      ],
      "port": 8503
    }
  ]
}
