[Unit]
Description=Ecommerce Store: Cloudflare quick tunnel to the Admin dashboard
After=network-online.target store-admin.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --url http://localhost:8502
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
