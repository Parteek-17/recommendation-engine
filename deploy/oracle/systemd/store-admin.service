[Unit]
Description=Ecommerce Store: Admin dashboard (:8502)
After=network-online.target 
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP__
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP__/.venv/bin/python -m streamlit run ui/control_room.py --server.port 8502 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
